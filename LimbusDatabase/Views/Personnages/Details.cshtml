@model LimbusDatabase.ViewModels.DetailViewModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<div>
    <h4>Personnage</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Personnage.Nom)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Personnage.Nom)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Personnage.Prenom)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Personnage.Prenom)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Personnage.District)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Personnage.District)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Personnage.EnVie)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Personnage.EnVie)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Personnage.Faction)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Personnage.Faction.FactionId)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ImageUrl)
        </dt>
        <dd class="col-sm-10">
            <img alt="@(Model.Personnage.Prenom)" src="@(Model.ImageUrl)"></img>
        </dd>
    </dl>
</div>
<div>
   
    <a asp-action="Index">Back to List</a>
</div>
