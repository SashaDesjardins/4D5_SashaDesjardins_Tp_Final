@model LimbusDatabase.ViewModels.MortDeFactionDistrictViewModel
<h1>Tuer un personnage</h1>
<form asp-action="MortDeFactionDistrict">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="FactionId" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="FactionId" class="form-control" />
            <span asp-validation-for="FactionId" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="District" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="District" class="form-control" />
            <span asp-validation-for="District" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-default">Executer</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
